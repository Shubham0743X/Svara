{
  "name": "svara",
  "version": "1.3.0",
  "description": "Svara — YouTube Music player for PC, no login",
  "main": "electron/main.js",
  "icon": "build/icon.png",
  "author": "Shubham Nag",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "dev": "electron .",
    "build": "electron-builder --win portable"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "express": "^4.19.2",
    "youtubei.js": "latest"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.shubham0743x.svara",
    "productName": "Svara",
    "files": [
      "**/*",
      "!.freebuff/**",
      "!**/*.log",
      "!screenshots/**",
      "!dist/**",
      "!PLAN.md",
      "!WAVE0-NOTES.md",
      "!*.backup.*",
      "!yt-dlp.exe"
    ],
    "extraResources": [
      { "from": "yt-dlp.exe", "to": "yt-dlp.exe" }
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "${productName}.${version}.exe"
    }
  }
}
